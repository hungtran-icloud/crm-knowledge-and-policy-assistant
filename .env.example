# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ckpa:ckpa_pass@localhost:5432/ckpa_db
DATABASE_POOL_SIZE=10

# ── Object Storage (S3-compatible) ───────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ckpa-documents

# ── Redis (optional cache / rate-limit) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Chọn: openai | azure | local — cần đánh giá retention/privacy trước khi prod
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=900
LLM_MAX_CALLS_PER_MONTH=2000

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Identity / Auth ──────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Import Service ───────────────────────────────────────────────────────────
IMPORT_OUTPUT_DIR=data/output
IMPORT_MAX_ROWS_PER_BATCH=500
IMPORT_SNAPSHOT_STALENESS_HOURS=25

# ── Worker / Scheduler ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
