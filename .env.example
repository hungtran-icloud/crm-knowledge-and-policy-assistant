# SongNhat CRM — Environment Variables Reference
# Copy to .env and fill in real values. Never commit .env to source control.

# --- Database ---
DATABASE_URL=postgresql://songnhat:songnhat_dev@localhost:5432/songnhat_crm

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider (question-service) ---
# OpenAI-compatible API endpoint. Examples:
#   Azure OpenAI: https://<your-resource>.openai.azure.com/
#   Google Vertex (via proxy): https://...
#   Local vLLM: http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=gpt-4o-mini
MOCK_LLM=false

# --- Auth (placeholder — configure with org identity provider) ---
# JWT_SECRET=your-jwt-secret
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=

# --- Service URLs (for inter-service communication) ---
KNOWLEDGE_STORE_URL=http://localhost:8002
AUDIT_SERVICE_URL=http://localhost:8005

# --- Logging ---
LOG_LEVEL=INFO
# LOG_FORMAT=json | console
LOG_FORMAT=json

# --- Service Caps (RFP OPS02) ---
MAX_CONCURRENT_USERS=5
MONTHLY_PACKAGE_CAP=1000
MONTHLY_LLM_CALL_CAP=2000
MAX_LLM_INPUT_TOKENS=6000
MAX_LLM_OUTPUT_TOKENS=900
MAX_PASSAGES_PER_PACKAGE=8
